// RUN: cir-opt %s --verify-roundtrip | FileCheck %s

!s128i_bitint = !cir.int<s, 128, bitint>
!u128i_bitint = !cir.int<u, 128, bitint>

module {
  // Round-trip verification exercises arbitrary-precision parsing,
  // verification, and printing without narrowing the APInt to a native
  // integer.
  // CHECK-LABEL: cir.func @wide_int_attrs
  cir.func @wide_int_attrs() {
    // CHECK: cir.const #cir.int<-9223372036854775808> : !s128i_bitint
    %0 = cir.const #cir.int<-9223372036854775808> : !s128i_bitint
    // CHECK: cir.const #cir.int<18446744073709551615> : !u128i_bitint
    %1 = cir.const #cir.int<18446744073709551615> : !u128i_bitint
    // CHECK: cir.const #cir.int<-170141183460469231731687303715884105728> : !s128i_bitint
    %2 = cir.const #cir.int<-170141183460469231731687303715884105728> : !s128i_bitint
    // CHECK: cir.const #cir.int<319435266158123073073250785136463577088> : !u128i_bitint
    %3 = cir.const #cir.int<319435266158123073073250785136463577088> : !u128i_bitint
    cir.return
  }
}
