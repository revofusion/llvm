// RUN: cir-opt %s -verify-diagnostics -split-input-file

!s32i = !cir.int<s, 32>
!rec_Field = !cir.struct<"Field" {!s32i}>
!rec_Owner = !cir.struct<"Owner" {!rec_Field}>

module {
  cir.func @incomplete_endpoint(%owner : !cir.ptr<!rec_Owner>) {
    // expected-error@+1 {{record member endpoint metadata is incomplete}}
    %field = cir.get_member %owner[0] {ast_declaring_record_usr = "c:@S@Owner", ast_member_decl_usr = "c:@S@Owner@FI@field", ast_member_offset_bits = 0 : i64, ast_member_record_endpoint = {declaring_record_usr = "c:@S@Owner", field_decl_usr = "c:@S@Owner@FI@field", field_offset_bits = 0 : i64, field_storage_type = !rec_Field, record_schema = !rec_Field, record_usr = "c:@S@Field"}, name = "field"} : !cir.ptr<!rec_Owner> -> !cir.ptr<!rec_Field>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>
!rec_Field = !cir.struct<"Field" {!s32i}>
!rec_Owner = !cir.struct<"Owner" {!rec_Field}>

module {
  cir.func @contradictory_endpoint(%owner : !cir.ptr<!rec_Owner>) {
    // expected-error@+1 {{record member endpoint metadata contradicts direct FieldDecl identity}}
    %field = cir.get_member %owner[0] {ast_declaring_record_usr = "c:@S@Owner", ast_member_decl_usr = "c:@S@Owner@FI@field", ast_member_offset_bits = 0 : i64, ast_member_record_endpoint = {declaring_record_usr = "c:@S@OtherOwner", field_decl_usr = "c:@S@OtherOwner@FI@field", field_offset_bits = 0 : i64, field_storage_type = !rec_Field, record_schema = !rec_Field, record_usr = "c:@S@Field", source_type = [{}]}, name = "field"} : !cir.ptr<!rec_Owner> -> !cir.ptr<!rec_Field>
    cir.return
  }
}

// -----

!s32i = !cir.int<s, 32>
!rec_Field = !cir.struct<"Field" {!s32i}>
!rec_Owner = !cir.struct<"Owner" {!rec_Field}>

module {
  cir.func @wrong_storage_endpoint(%owner : !cir.ptr<!rec_Owner>) {
    // expected-error@+1 {{record member endpoint storage type does not match result pointee}}
    %field = cir.get_member %owner[0] {ast_declaring_record_usr = "c:@S@Owner", ast_member_decl_usr = "c:@S@Owner@FI@field", ast_member_offset_bits = 0 : i64, ast_member_record_endpoint = {declaring_record_usr = "c:@S@Owner", field_decl_usr = "c:@S@Owner@FI@field", field_offset_bits = 0 : i64, field_storage_type = !s32i, record_schema = !rec_Field, record_usr = "c:@S@Field", source_type = [{}]}, name = "field"} : !cir.ptr<!rec_Owner> -> !cir.ptr<!rec_Field>
    cir.return
  }
}
